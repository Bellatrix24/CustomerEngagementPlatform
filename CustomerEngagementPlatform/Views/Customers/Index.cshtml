@model IEnumerable<CustomerEngagementPlatform.Models.Customer>

@{
    ViewData["Title"] = "Customers";
    ViewData["HideNavbar"] = true;
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,100..900;1,9..144,100..900&family=Archivo:ital,wght@0,100..900;1,100..900&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap');

    .portal-wrapper {
        font-family: 'Archivo', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        color: #111111;
        background-color: #fafafa;
        max-width: 1200px;
        margin: 0 auto;
        padding: 4rem 2rem;
    }

    .brutalist-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 2.8rem;
        padding: 0 1.5rem;
        font-size: 0.95rem;
        font-weight: 600;
        text-decoration: none;
        border-radius: 0 !important;
        transition: all 0.15s ease-in-out;
        text-align: center;
        box-sizing: border-box;
        border: none;
    }

    .brutalist-btn-primary {
        background-color: #111111;
        color: #ffffff;
        border: 2px solid #111111;
    }

    .brutalist-btn-primary:hover {
        background-color: #333333;
        border-color: #333333;
        color: #ffffff;
    }

    .brutalist-table-container {
        background-color: #ffffff;
        border: 1px solid #dddddd;
        border-radius: 0 !important;
    }

    .brutalist-table {
        width: 100%;
        border-collapse: collapse;
    }

    .brutalist-table th {
        font-family: 'JetBrains Mono', monospace;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 0.05rem;
        background-color: #fafafa;
        border-bottom: 2px solid #111111;
        color: #666666;
        padding: 1rem;
        text-align: left;
    }

    .brutalist-table td {
        padding: 1.25rem 1rem;
        border-bottom: 1px solid #eeeeee;
    }

    .brutalist-table tbody tr:hover {
        background-color: #fcfcfc;
    }

    .action-link {
        font-size: 0.9rem;
        font-weight: 500;
        color: #111111;
        text-decoration: underline;
        transition: color 0.15s ease;
    }

    .action-link:hover {
        color: #0044cc;
    }

    .action-link-danger {
        color: #9b1c1c;
    }

    .action-link-danger:hover {
        color: #df2121;
    }
</style>

<div class="portal-wrapper">
    <!-- Header/Back Navigation -->
    <div class="mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
        <a href="/" class="text-decoration-none d-inline-flex align-items-center fw-medium" style="font-size: 0.95rem; color: #111111;">
            ← Home
        </a>
        <div class="d-flex align-items-center gap-3 text-muted small flex-wrap">
            <a asp-controller="Dashboard" asp-action="Index" class="text-decoration-underline text-muted fw-medium" style="font-size: 0.9rem;">Dashboard</a>
            <span class="text-muted">|</span>
            <a asp-controller="Tickets" asp-action="Index" class="text-decoration-underline text-muted fw-medium" style="font-size: 0.9rem;">Tickets</a>
            <span class="text-muted">|</span>
            <span>Logged in as <strong>@User.Identity?.Name</strong></span>
            <span class="text-muted">|</span>
            <form class="d-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                <button type="submit" class="btn btn-link text-muted p-0 align-baseline text-decoration-underline small" style="font-size: 0.85rem;">Logout</button>
            </form>
        </div>
    </div>

    <!-- Title and Action -->
    <div class="d-flex justify-content-between align-items-end mb-5 flex-wrap gap-3 pb-4 border-bottom" style="border-bottom-color: #dddddd !important;">
        <div>
            <div class="text-uppercase tracking-wider text-muted mb-1" style="font-family: 'JetBrains Mono', monospace; font-size: 0.8rem; font-weight: 600; letter-spacing: 0.05rem;">Staff Access</div>
            <h1 class="display-6 mb-2" style="font-family: 'Fraunces', Georgia, serif; font-weight: 300; color: #111111; letter-spacing: -0.05rem;">Customers</h1>
            <p class="text-muted mb-0" style="font-size: 1.05rem;">Manage customer records and review linked support ticket activity.</p>
        </div>
        <div>
            <a asp-action="Create" class="brutalist-btn brutalist-btn-primary px-4">
                Create New Customer
            </a>
        </div>
    </div>

    <!-- Table Container -->
    <div class="brutalist-table-container table-responsive">
        <table class="table brutalist-table align-middle mb-0">
            <thead>
                <tr>
                    <th style="width: 20%;">Name</th>
                    <th style="width: 20%;">Email</th>
                    <th style="width: 15%;">Phone</th>
                    <th style="width: 20%;">Address</th>
                    <th style="width: 13%;">Created At</th>
                    <th style="width: 7%;">Tickets</th>
                    <th style="width: 15%; text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold text-dark">@item.Name</td>
                        <td>@item.Email</td>
                        <td>@item.Phone</td>
                        <td class="text-truncate" style="max-width: 200px;" title="@item.Address">@item.Address</td>
                        <td>
                            @if (item.CreatedAt != default)
                            {
                                <div class="text-dark">@item.CreatedAt.ToString("MMM dd, yyyy")</div>
                            }
                            else
                            {
                                <div class="text-muted small">--</div>
                            }
                        </td>
                        <td class="fw-bold text-secondary">
                            @(item.Tickets != null ? item.Tickets.Count : 0)
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-2">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="action-link">Edit</a>
                                <span class="text-muted">|</span>
                                <a asp-action="Details" asp-route-id="@item.Id" class="action-link">Details</a>
                                <span class="text-muted">|</span>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="action-link action-link-danger">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>