@model CustomerEngagementPlatform.Models.Customer

@{
    ViewData["Title"] = "Delete Customer";
    ViewData["HideNavbar"] = true;
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,100..900;1,9..144,100..900&family=Archivo:ital,wght@0,100..900;1,100..900&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap');

    .portal-wrapper {
        font-family: 'Archivo', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        color: #111111;
        background-color: #fafafa;
        max-width: 800px;
        margin: 0 auto;
        padding: 4rem 2rem;
    }

    .brutalist-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 2.8rem;
        padding: 0 1.5rem;
        font-size: 0.95rem;
        font-weight: 600;
        text-decoration: none;
        border-radius: 0 !important;
        transition: all 0.15s ease-in-out;
        text-align: center;
        box-sizing: border-box;
        border: none;
    }

    .brutalist-btn-danger {
        background-color: #9b1c1c;
        color: #ffffff;
        border: 2px solid #9b1c1c;
    }

    .brutalist-btn-danger:hover:not([disabled]) {
        background-color: #b91c1c;
        border-color: #b91c1c;
        color: #ffffff;
    }

    .brutalist-btn-danger[disabled] {
        background-color: #f3f4f6;
        color: #9ca3af;
        border-color: #e5e7eb;
        cursor: not-allowed;
    }

    .brutalist-card {
        background-color: #ffffff;
        border: 1px solid #dddddd;
        border-radius: 0 !important;
        padding: 3rem;
        box-shadow: none !important;
    }

    .action-link {
        font-size: 0.95rem;
        font-weight: 500;
        color: #111111;
        text-decoration: underline;
        transition: color 0.15s ease;
    }

    .action-link:hover {
        color: #0044cc;
    }

    .delete-alert {
        background-color: #fdf2f2;
        color: #9b1c1c;
        border: 1px solid #f8b4b4;
        border-radius: 0 !important;
        padding: 1rem;
        font-size: 0.95rem;
        margin-bottom: 2rem;
    }
</style>

<div class="portal-wrapper">
    <!-- Header/Back Navigation -->
    <div class="mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
        <a asp-action="Index" class="text-decoration-none d-inline-flex align-items-center fw-medium" style="font-size: 0.95rem; color: #111111;">
            ← Back to Customers
        </a>
        <div class="d-flex align-items-center gap-3 text-muted small flex-wrap">
            <a asp-controller="Dashboard" asp-action="Index" class="text-decoration-underline text-muted fw-medium" style="font-size: 0.9rem;">Dashboard</a>
            <span class="text-muted">|</span>
            <a asp-controller="Tickets" asp-action="Index" class="text-decoration-underline text-muted fw-medium" style="font-size: 0.9rem;">Tickets</a>
            <span class="text-muted">|</span>
            <span>Logged in as <strong>@User.Identity?.Name</strong></span>
            <span class="text-muted">|</span>
            <form class="d-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                <button type="submit" class="btn btn-link text-muted p-0 align-baseline text-decoration-underline small" style="font-size: 0.85rem;">Logout</button>
            </form>
        </div>
    </div>

    <!-- Title Header -->
    <div class="mb-5 pb-4 border-bottom" style="border-bottom-color: #dddddd !important;">
        <h1 class="display-6 mb-2" style="font-family: 'Fraunces', Georgia, serif; font-weight: 300; color: #111111; letter-spacing: -0.05rem;">Delete Customer</h1>
        <p class="text-muted mb-0" style="font-size: 1.05rem;">Review customer details before deletion.</p>
    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="delete-alert d-flex align-items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-exclamation-triangle-fill flex-shrink-0" viewBox="0 0 16 16">
                <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
            </svg>
            <div>@ViewBag.ErrorMessage</div>
        </div>
    }
    else
    {
        <div class="delete-alert d-flex align-items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-exclamation-circle-fill flex-shrink-0" viewBox="0 0 16 16">
                <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM8 4a.905.905 0 0 0-.9.995l.35 3.507a.552.552 0 0 0 1.1 0l.35-3.507A.905.905 0 0 0 8 4zm.002 6a1 1 0 1 0 0 2 1 1 0 0 0 0-2z"/>
            </svg>
            <div>Are you sure you want to permanently delete this customer profile? This action cannot be undone.</div>
        </div>
    }

    <!-- Details Card -->
    <div class="brutalist-card">
        <h5 class="fw-bold text-dark mb-4 border-bottom pb-3" style="font-family: 'Fraunces', Georgia, serif; font-size: 1.3rem; border-bottom-color: #eeeeee !important;">Customer Profile Info</h5>
        
        <div class="row g-4 pt-2 mb-4">
            <div class="col-sm-6">
                <div class="mb-3">
                    <span class="text-secondary small text-uppercase d-block" style="font-family: 'JetBrains Mono', monospace; font-size: 0.75rem;">Name</span>
                    <span class="fs-5 fw-bold text-dark">@Model.Name</span>
                </div>
                <div class="mb-3">
                    <span class="text-secondary small text-uppercase d-block" style="font-family: 'JetBrains Mono', monospace; font-size: 0.75rem;">Email Address</span>
                    <span class="text-dark">@Model.Email</span>
                </div>
                <div>
                    <span class="text-secondary small text-uppercase d-block" style="font-family: 'JetBrains Mono', monospace; font-size: 0.75rem;">Phone Number</span>
                    <span class="text-dark">@Model.Phone</span>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="mb-3">
                    <span class="text-secondary small text-uppercase d-block" style="font-family: 'JetBrains Mono', monospace; font-size: 0.75rem;">Address</span>
                    <span class="text-dark">@(string.IsNullOrEmpty(Model.Address) ? "N/A" : Model.Address)</span>
                </div>
                <div>
                    <span class="text-secondary small text-uppercase d-block" style="font-family: 'JetBrains Mono', monospace; font-size: 0.75rem;">Member Since</span>
                    <span class="text-dark">@Model.CreatedAt.ToString("MMMM dd, yyyy")</span>
                </div>
            </div>
        </div>

        <!-- Form / Actions -->
        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            
            <div class="d-flex justify-content-between align-items-center mt-5 pt-3 border-top" style="border-top-color: #eeeeee !important;">
                <a asp-action="Index" class="action-link">Cancel</a>
                
                @if (ViewBag.HasActiveTickets == true)
                {
                    <button type="submit" class="brutalist-btn brutalist-btn-danger" disabled>Delete Account</button>
                }
                else
                {
                    <button type="submit" class="brutalist-btn brutalist-btn-danger">Delete Account</button>
                }
            </div>
        </form>
    </div>
</div>
