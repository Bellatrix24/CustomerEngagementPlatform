@model CustomerEngagementPlatform.Models.Customer

@{
    ViewData["Title"] = "Customer Details";
    ViewData["HideNavbar"] = true;
    var totalTickets = Model.Tickets != null ? Model.Tickets.Count : 0;
    var openTickets = Model.Tickets != null ? Model.Tickets.Count(t => t.Status == "Open") : 0;
    var resolvedTickets = Model.Tickets != null ? Model.Tickets.Count(t => t.Status == "Resolved") : 0;
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,100..900;1,9..144,100..900&family=Archivo:ital,wght@0,100..900;1,100..900&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap');

    .portal-wrapper {
        font-family: 'Archivo', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        color: #111111;
        background-color: #fafafa;
        max-width: 900px;
        margin: 0 auto;
        padding: 4rem 2rem;
    }

    .brutalist-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 2.8rem;
        padding: 0 1.5rem;
        font-size: 0.95rem;
        font-weight: 600;
        text-decoration: none;
        border-radius: 0 !important;
        transition: all 0.15s ease-in-out;
        text-align: center;
        box-sizing: border-box;
        border: none;
    }

    .brutalist-btn-primary {
        background-color: #111111;
        color: #ffffff;
        border: 2px solid #111111;
    }

    .brutalist-btn-primary:hover {
        background-color: #333333;
        border-color: #333333;
        color: #ffffff;
    }

    .brutalist-btn-outline {
        background-color: #ffffff;
        color: #111111;
        border: 1px solid #cccccc;
        font-size: 0.85rem;
        font-weight: 500;
        height: 2.8rem;
        padding: 0 1.5rem;
    }

    .brutalist-btn-outline:hover {
        border-color: #111111;
        background-color: #f9f9f9;
        color: #111111;
    }

    .brutalist-card {
        background-color: #ffffff;
        border: 1px solid #dddddd;
        border-radius: 0 !important;
        padding: 3rem;
        box-shadow: none !important;
    }

    .action-link {
        font-size: 0.95rem;
        font-weight: 500;
        color: #111111;
        text-decoration: underline;
        transition: color 0.15s ease;
    }

    .action-link:hover {
        color: #0044cc;
    }
</style>

<div class="portal-wrapper">
    <!-- Header/Back Navigation -->
    <div class="mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
        <a asp-action="Index" class="text-decoration-none d-inline-flex align-items-center fw-medium" style="font-size: 0.95rem; color: #111111;">
            ← Back to Customers
        </a>
        <div class="d-flex align-items-center gap-3 text-muted small flex-wrap">
            <a asp-controller="Dashboard" asp-action="Index" class="text-decoration-underline text-muted fw-medium" style="font-size: 0.9rem;">Dashboard</a>
            <span class="text-muted">|</span>
            <a asp-controller="Tickets" asp-action="Index" class="text-decoration-underline text-muted fw-medium" style="font-size: 0.9rem;">Tickets</a>
            <span class="text-muted">|</span>
            <span>Logged in as <strong>@User.Identity?.Name</strong></span>
            <span class="text-muted">|</span>
            <form class="d-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                <button type="submit" class="btn btn-link text-muted p-0 align-baseline text-decoration-underline small" style="font-size: 0.85rem;">Logout</button>
            </form>
        </div>
    </div>

    <!-- Title Header -->
    <div class="mb-5 pb-4 border-bottom" style="border-bottom-color: #dddddd !important;">
        <h1 class="display-6 mb-2" style="font-family: 'Fraunces', Georgia, serif; font-weight: 300; color: #111111; letter-spacing: -0.05rem;">Customer Details</h1>
        <p class="text-muted mb-0" style="font-size: 1.05rem;">View customer profile and linked ticket activity.</p>
    </div>

    <!-- Metrics Cards Grid -->
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="brutalist-card text-center p-4">
                <div class="text-secondary mb-2 small text-uppercase fw-semibold" style="font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; letter-spacing: 0.03rem;">Total Tickets</div>
                <h3 class="fw-bold mb-0 display-6 text-dark">@totalTickets</h3>
            </div>
        </div>
        <div class="col-md-4">
            <div class="brutalist-card text-center p-4">
                <div class="text-secondary mb-2 small text-uppercase fw-semibold" style="font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; letter-spacing: 0.03rem;">Open Tickets</div>
                <h3 class="fw-bold mb-0 display-6" style="color: #b45309;">@openTickets</h3>
            </div>
        </div>
        <div class="col-md-4">
            <div class="brutalist-card text-center p-4">
                <div class="text-secondary mb-2 small text-uppercase fw-semibold" style="font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; letter-spacing: 0.03rem;">Resolved Tickets</div>
                <h3 class="fw-bold mb-0 display-6" style="color: #166534;">@resolvedTickets</h3>
            </div>
        </div>
    </div>

    <!-- Details Card -->
    <div class="brutalist-card">
        <h5 class="fw-bold text-dark mb-4 border-bottom pb-3" style="font-family: 'Fraunces', Georgia, serif; font-size: 1.3rem; border-bottom-color: #eeeeee !important;">Contact & Address Details</h5>
        
        <div class="row g-4 pt-2">
            <div class="col-sm-6">
                <div class="mb-3">
                    <span class="text-secondary small text-uppercase d-block" style="font-family: 'JetBrains Mono', monospace; font-size: 0.75rem;">Name</span>
                    <span class="fs-5 fw-bold text-dark">@Model.Name</span>
                </div>
                <div class="mb-3">
                    <span class="text-secondary small text-uppercase d-block" style="font-family: 'JetBrains Mono', monospace; font-size: 0.75rem;">Email Address</span>
                    <span class="text-dark">@Model.Email</span>
                </div>
                <div>
                    <span class="text-secondary small text-uppercase d-block" style="font-family: 'JetBrains Mono', monospace; font-size: 0.75rem;">Phone Number</span>
                    <span class="text-dark">@Model.Phone</span>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="mb-3">
                    <span class="text-secondary small text-uppercase d-block" style="font-family: 'JetBrains Mono', monospace; font-size: 0.75rem;">Address</span>
                    <span class="text-dark">@(string.IsNullOrEmpty(Model.Address) ? "N/A" : Model.Address)</span>
                </div>
                <div>
                    <span class="text-secondary small text-uppercase d-block" style="font-family: 'JetBrains Mono', monospace; font-size: 0.75rem;">Member Since</span>
                    <span class="text-dark">@Model.CreatedAt.ToString("MMMM dd, yyyy")</span>
                </div>
            </div>
        </div>

        <!-- Details Actions -->
        <div class="d-flex justify-content-between align-items-center mt-5 pt-3 border-top" style="border-top-color: #eeeeee !important;">
            <a asp-action="Index" class="action-link">Back to List</a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="brutalist-btn brutalist-btn-primary text-decoration-none">Edit Profile</a>
        </div>
    </div>
</div>