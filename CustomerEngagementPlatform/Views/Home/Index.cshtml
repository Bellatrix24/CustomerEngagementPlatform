@{
    ViewData["Title"] = "Welcome";
    ViewData["HideNavbar"] = true;
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,100..900;1,9..144,100..900&family=Archivo:ital,wght@0,100..900;1,100..900&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap');

    .home-wrapper {
        font-family: 'Archivo', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        color: #111111;
        background-color: #fafafa;
        max-width: 1200px;
        margin: 0 auto;
        padding: 7rem 2rem;
    }

    .home-eyebrow {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.15rem;
        text-transform: uppercase;
        color: #888888;
        margin-bottom: 2rem;
        display: block;
        opacity: 0;
        animation: homeFadeIn 0.8s ease-out forwards;
    }

    .home-title {
        font-family: 'Fraunces', Georgia, serif;
        font-size: 4.8rem;
        font-weight: 300;
        line-height: 1.05;
        letter-spacing: -0.15rem;
        color: #111111;
        margin-bottom: 2rem;
        opacity: 0;
        animation: homeFadeIn 0.8s ease-out 0.2s forwards;
    }

    .home-title span {
        display: block;
    }

    .home-description {
        font-size: 1.35rem;
        font-weight: 400;
        line-height: 1.6;
        color: #444444;
        max-width: 700px;
        margin-bottom: 4rem;
        opacity: 0;
        animation: homeFadeIn 0.8s ease-out 0.4s forwards;
    }

    .home-divider {
        border: none;
        border-top: 1px solid #dddddd;
        margin: 0 0 4rem 0;
        opacity: 0;
        animation: homeFadeIn 0.8s ease-out 0.6s forwards;
    }

    /* Portal Access Section */
    .home-portals {
        display: flex;
        gap: 2rem;
        margin-bottom: 5rem;
        opacity: 0;
        animation: homeFadeIn 0.8s ease-out 0.8s forwards;
    }

    .home-portal-card {
        flex: 1;
        background-color: #ffffff;
        border: 1px solid #dddddd;
        border-radius: 0 !important;
        padding: 3rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-height: 320px;
        transition: border-color 0.2s ease;
    }

    .home-portal-card:hover {
        border-color: #111111;
    }

    .home-portal-num {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.9rem;
        color: #999999;
        margin-bottom: 1.5rem;
        display: block;
    }

    .home-portal-title {
        font-family: 'Fraunces', Georgia, serif;
        font-size: 2rem;
        font-weight: 400;
        color: #111111;
        margin-bottom: 1rem;
    }

    .home-portal-desc {
        font-size: 1rem;
        line-height: 1.6;
        color: #666666;
        margin-bottom: 2.5rem;
    }

    .home-portal-action {
        margin-top: auto;
    }

    .home-portal-btn {
        display: inline-flex;
        align-items: center;
        font-size: 1.1rem;
        font-weight: 600;
        color: #111111;
        text-decoration: none;
        margin-bottom: 0.75rem;
        transition: transform 0.15s ease;
    }

    .home-portal-btn:hover {
        transform: translateX(4px);
        color: #000000;
    }

    .home-portal-meta {
        display: block;
        font-size: 0.85rem;
        color: #999999;
    }

    .home-portal-meta a {
        color: #555555;
        text-decoration: underline;
        transition: color 0.15s ease;
    }

    .home-portal-meta a:hover {
        color: #111111;
    }

    /* Capabilities Section */
    .home-section-title {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.15rem;
        text-transform: uppercase;
        color: #777777;
        margin-bottom: 3rem;
        display: block;
    }

    .home-capabilities-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.5rem;
        margin-bottom: 6rem;
    }

    .home-capability-item {
        background-color: #ffffff;
        border: 1px solid #e5e5e5;
        border-radius: 0 !important;
        padding: 2rem;
        display: flex;
        flex-direction: column;
        height: 100%;
        transition: border-color 0.2s ease;
    }

    .home-capability-item:hover {
        border-color: #111111;
    }

    .home-cap-num {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.8rem;
        color: #bbbbbb;
        margin-bottom: 1rem;
        display: block;
    }

    .home-cap-title {
        font-family: 'Fraunces', Georgia, serif;
        font-size: 1.3rem;
        font-weight: 400;
        color: #111111;
        margin-bottom: 0.75rem;
    }

    .home-cap-desc {
        font-size: 0.9rem;
        line-height: 1.5;
        color: #666666;
        margin: 0;
    }

    /* Tech Stack Carousel styles */
    .brutalist-carousel-wrapper {
        overflow: hidden;
        width: 100%;
        position: relative;
        padding: 1.5rem 0;
        background-color: transparent;
        margin-top: 1.5rem;
    }

    .brutalist-carousel-wrapper::before,
    .brutalist-carousel-wrapper::after {
        content: "";
        position: absolute;
        top: 0;
        width: 15%;
        height: 100%;
        z-index: 2;
        pointer-events: none;
    }

    .brutalist-carousel-wrapper::before {
        left: 0;
        background: linear-gradient(to right, #fafafa 0%, transparent 100%);
    }

    .brutalist-carousel-wrapper::after {
        right: 0;
        background: linear-gradient(to left, #fafafa 0%, transparent 100%);
    }

    .brutalist-carousel-track {
        display: flex;
        width: max-content;
        animation: brutalistScroll 40s linear infinite;
    }

    .brutalist-carousel-track:hover {
        animation-play-state: paused;
    }

    .brutalist-carousel-item {
        display: flex;
        align-items: center;
        padding: 0.6rem 1.25rem;
        margin: 0 0.75rem;
        background-color: #ffffff;
        border: 1px solid #cccccc;
        font-weight: 600;
        font-size: 0.9rem;
        color: #111111;
        white-space: nowrap;
        border-radius: 0 !important;
        transition: border-color 0.15s ease-in-out;
    }

    .brutalist-carousel-item:hover {
        border-color: #111111;
    }

    .tech-logo {
        margin-right: 0.65rem;
        flex-shrink: 0;
    }

    @@keyframes brutalistScroll {
        0% {
            transform: translateX(0);
        }
        100% {
            transform: translateX(-50%);
        }
    }

    @@keyframes homeFadeIn {
        from {
            opacity: 0;
            transform: translateY(15px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Responsive */
    @@media (max-width: 1024px) {
        .home-capabilities-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 768px) {
        .home-wrapper {
            padding: 4rem 1.5rem;
        }
        .home-title {
            font-size: 3.5rem;
            letter-spacing: -0.08rem;
        }
        .home-portals {
            flex-direction: column;
            gap: 2rem;
        }
        .home-capabilities-grid {
            grid-template-columns: 1fr;
        }
        .home-portal-card {
            min-height: auto;
            padding: 2rem;
        }
    }
</style>

<div class="home-wrapper">
    <span class="home-eyebrow">WIPRO CAPSTONE PROJECT</span>
    
    <h1 class="home-title">
        <span>Customer</span>
        <span>Engagement</span>
        <span>Platform</span>
    </h1>
    
    <p class="home-description">
        Manage support requests, track customer relationships, and analyze service efficiency.
    </p>
    
    <hr class="home-divider" />
    
    <!-- Portal Access Section -->
    <div class="home-portals">
        <!-- Customer Portal -->
        <div class="home-portal-card">
            <div>
                <span class="home-portal-num">01</span>
                <h2 class="home-portal-title">Customer Portal</h2>
                <p class="home-portal-desc">
                    Submit support tickets, view service updates, and track resolutions.
                </p>
            </div>
            <div class="home-portal-action">
                <a asp-controller="CustomerPortal" asp-action="Index" class="home-portal-btn">
                    Enter portal &rarr;
                </a>
                <span class="home-portal-meta">
                    No account? <a href="/Identity/Account/Register">Register</a>
                </span>
            </div>
        </div>
        
        <!-- Staff Dashboard -->
        <div class="home-portal-card">
            <div>
                <span class="home-portal-num">02</span>
                <h2 class="home-portal-title">Staff Dashboard</h2>
                <p class="home-portal-desc">
                    Manage customer lists, process tickets, and monitor service efficiency.
                </p>
            </div>
            <div class="home-portal-action">
                <a asp-area="Identity" asp-page="/Account/Login" asp-route-portal="staff" class="home-portal-btn">
                    Staff access &rarr;
                </a>
                <span class="home-portal-meta">
                    Authorized members only
                </span>
            </div>
        </div>
    </div>

    <!-- Capabilities Section -->
    <div class="py-5 border-top">
        <span class="home-section-title">CAPABILITIES</span>
        
        <div class="home-capabilities-grid">
            <!-- Item 1 -->
            <div class="home-capability-item">
                <span class="home-cap-num">01</span>
                <h4 class="home-cap-title">Ticket Tracking</h4>
                <p class="home-cap-desc">Create, view, and track support tickets from request to resolution.</p>
            </div>
            <!-- Item 2 -->
            <div class="home-capability-item">
                <span class="home-cap-num">02</span>
                <h4 class="home-cap-title">Customer Directory</h4>
                <p class="home-cap-desc">Maintain customer details and connect them with service history.</p>
            </div>
            <!-- Item 3 -->
            <div class="home-capability-item">
                <span class="home-cap-num">03</span>
                <h4 class="home-cap-title">Service Analytics</h4>
                <p class="home-cap-desc">Review open, resolved, and unassigned tickets to understand efficiency.</p>
            </div>
            <!-- Item 4 -->
