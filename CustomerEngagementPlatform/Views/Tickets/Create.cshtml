@model CustomerEngagementPlatform.Models.Ticket

@{
    ViewData["Title"] = "Create Ticket";
    ViewData["HideNavbar"] = true;
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,100..900;1,9..144,100..900&family=Archivo:ital,wght@0,100..900;1,100..900&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap');

    .portal-wrapper {
        font-family: 'Archivo', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        color: #111111;
        background-color: #fafafa;
        max-width: 800px;
        margin: 0 auto;
        padding: 4rem 2rem;
    }

    .brutalist-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 2.8rem;
        padding: 0 1.5rem;
        font-size: 0.95rem;
        font-weight: 600;
        text-decoration: none;
        border-radius: 0 !important;
        transition: all 0.15s ease-in-out;
        text-align: center;
        box-sizing: border-box;
        border: none;
    }

    .brutalist-btn-primary {
        background-color: #111111;
        color: #ffffff;
        border: 2px solid #111111;
    }

    .brutalist-btn-primary:hover {
        background-color: #333333;
        border-color: #333333;
        color: #ffffff;
    }

    .brutalist-card {
        background-color: #ffffff;
        border: 1px solid #dddddd;
        border-radius: 0 !important;
        padding: 3rem;
        box-shadow: none !important;
    }

    .form-control, .form-select {
        border-radius: 0 !important;
        border: 1px solid #cccccc;
        color: #111111;
        padding: 0.75rem;
    }

    .form-control:focus, .form-select:focus {
        border-color: #111111 !important;
        box-shadow: none !important;
    }

    .action-link {
        font-size: 0.95rem;
        font-weight: 500;
        color: #111111;
        text-decoration: underline;
        transition: color 0.15s ease;
    }

    .action-link:hover {
        color: #0044cc;
    }

    .section-heading {
        font-family: 'Fraunces', Georgia, serif;
        font-size: 1.3rem;
        font-weight: 400;
        color: #111111;
        border-bottom: 1px solid #111111;
        padding-bottom: 0.5rem;
        margin-bottom: 1.5rem;
    }
</style>

<div class="portal-wrapper">
    <!-- Header/Back Navigation -->
    <div class="mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
        <a asp-action="Index" class="text-decoration-none d-inline-flex align-items-center fw-medium" style="font-size: 0.95rem; color: #111111;">
            ← Back to Tickets
        </a>
        <div class="d-flex align-items-center gap-3 text-muted small flex-wrap">
            <a asp-controller="Dashboard" asp-action="Index" class="text-decoration-underline text-muted fw-medium" style="font-size: 0.9rem;">Dashboard</a>
            <span class="text-muted">|</span>
            <a asp-controller="Customers" asp-action="Index" class="text-decoration-underline text-muted fw-medium" style="font-size: 0.9rem;">Customers</a>
            <span class="text-muted">|</span>
            <span>Logged in as <strong>@User.Identity?.Name</strong></span>
            <span class="text-muted">|</span>
            <form class="d-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                <button type="submit" class="btn btn-link text-muted p-0 align-baseline text-decoration-underline small" style="font-size: 0.85rem;">Logout</button>
            </form>
        </div>
    </div>

    <!-- Title Header -->
    <div class="mb-5 pb-4 border-bottom" style="border-bottom-color: #dddddd !important;">
        <h1 class="display-6 mb-2" style="font-family: 'Fraunces', Georgia, serif; font-weight: 300; color: #111111; letter-spacing: -0.05rem;">Create Ticket</h1>
        <p class="text-muted mb-0" style="font-size: 1.05rem;">Add a new support ticket for a customer.</p>
    </div>

    <!-- Form Container -->
    <div class="brutalist-card">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="row g-4">
                <div class="col-12">
                    <h5 class="section-heading">Ticket Details</h5>
                </div>

                <!-- Subject -->
                <div class="col-12">
                    <label asp-for="Subject" class="form-label fw-semibold text-dark"></label>
                    <input asp-for="Subject" class="form-control" placeholder="Ticket Subject" />
                    <span asp-validation-for="Subject" class="text-danger small"></span>
                </div>

                <!-- Description -->
                <div class="col-12">
                    <label asp-for="Description" class="form-label fw-semibold text-dark"></label>
                    <textarea asp-for="Description" rows="4" class="form-control" placeholder="Describe the issue..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <!-- Customer Selection -->
                <div class="col-md-6">
                    <label asp-for="CustomerId" class="form-label fw-semibold text-dark">Customer</label>
                    <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.CustomerId"></select>
                    <span asp-validation-for="CustomerId" class="text-danger small"></span>
                </div>

                <!-- Status -->
                <div class="col-md-6">
                    <label asp-for="Status" class="form-label fw-semibold text-dark"></label>
                    <select asp-for="Status" class="form-select">
                        <option value="Open">Open</option>
                        <option value="In Progress">In Progress</option>
                        <option value="Resolved">Resolved</option>
                        <option value="Closed">Closed</option>
                    </select>
                    <span asp-validation-for="Status" class="text-danger small"></span>
                </div>

                <!-- Priority -->
                <div class="col-md-6">
                    <label asp-for="Priority" class="form-label fw-semibold text-dark"></label>
                    <select asp-for="Priority" class="form-select">
                        <option value="Low">Low</option>
                        <option value="Medium" selected>Medium</option>
                        <option value="High">High</option>
                    </select>
                    <span asp-validation-for="Priority" class="text-danger small"></span>
                </div>

                <!-- Assigned Agent -->
                <div class="col-md-6">
                    <label asp-for="AssignedAgent" class="form-label fw-semibold text-dark">Assigned Agent</label>
                    <select asp-for="AssignedAgent" class="form-select">
                        <option value="">Not Assigned</option>
                        <option value="Saumya">Saumya</option>
                        <option value="Support Team">Support Team</option>
                        <option value="Agent 1">Agent 1</option>
                    </select>
                    <span asp-validation-for="AssignedAgent" class="text-danger small"></span>
                </div>
            </div>

            <!-- Form Actions -->
            <div class="d-flex justify-content-between align-items-center mt-5 pt-3 border-top" style="border-top-color: #eeeeee !important;">
                <a asp-action="Index" class="action-link">Cancel</a>
                <button type="submit" class="brutalist-btn brutalist-btn-primary">Create Ticket</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}