@model IEnumerable<CustomerEngagementPlatform.Models.Ticket>

@{
    ViewData["Title"] = "Tickets";

    var selectedSearch = Context.Request.Query["searchString"].ToString();
    var selectedStatus = Context.Request.Query["statusFilter"].ToString();
    var selectedPriority = Context.Request.Query["priorityFilter"].ToString();
}

<h1>Tickets</h1>

<form asp-action="Index" method="get" class="mb-3">

    <div class="row">

        <div class="col-md-4">
            <input type="text"
                   name="searchString"
                   value="@selectedSearch"
                   class="form-control"
                   placeholder="Search tickets..." />
        </div>

        <div class="col-md-3">
            <select name="statusFilter" class="form-control">
                <option value="" selected="@(selectedStatus == "")">All Status</option>
                <option value="Open" selected="@(selectedStatus == "Open")">Open</option>
                <option value="In Progress" selected="@(selectedStatus == "In Progress")">In Progress</option>
                <option value="Resolved" selected="@(selectedStatus == "Resolved")">Resolved</option>
                <option value="Closed" selected="@(selectedStatus == "Closed")">Closed</option>
            </select>
        </div>

        <div class="col-md-3">
            <select name="priorityFilter" class="form-control">
                <option value="" selected="@(selectedPriority == "")">All Priority</option>
                <option value="Low" selected="@(selectedPriority == "Low")">Low</option>
                <option value="Medium" selected="@(selectedPriority == "Medium")">Medium</option>
                <option value="High" selected="@(selectedPriority == "High")">High</option>
            </select>
        </div>

        <div class="col-md-2">
            <button type="submit" class="btn btn-primary">
                Filter
            </button>
        </div>

    </div>

</form>

<p>
    <a asp-action="Create" class="btn btn-success">
        Create New Ticket
    </a>

    <a asp-action="Index" class="btn btn-secondary ms-2">
        Clear
    </a>
</p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Subject</th>
            <th>Status</th>
            <th>Priority</th>
            <th>Assigned Agent</th>
            <th>Customer</th>
            <th>Created At</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Subject</td>
                <td>@item.Status</td>
                <td>@item.Priority</td>
                <td>@item.AssignedAgent</td>
                <td>@item.Customer?.Name</td>
                <td>@item.CreatedAt.ToString("MM/dd/yyyy")</td>

                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }

    </tbody>
</table>